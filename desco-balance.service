[Unit]
Description=DESCO Balance API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yeasir
Group=yeasir
WorkingDirectory=/home/yeasir/desco-balance-api
EnvironmentFile=/home/yeasir/desco-balance-api/.env
ExecStart=/usr/local/bin/gunicorn -w 2 -b 0.0.0.0:8080 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
